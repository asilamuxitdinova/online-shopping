# Copy to .env (or run `make env`, which fills in random secrets).

# Address and port the API listens on. Keep 127.0.0.1 when nginx sits in front.
HOST=127.0.0.1
PORT=5000

# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Access tokens are short-lived JWTs; refresh tokens are long-lived and rotated on use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma-separated browser origins allowed to call the API (your frontend's URL).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to true only behind a reverse proxy that sets X-Real-IP (see deploy/nginx.conf).
TRUST_PROXY=false
# Login/register/refresh attempts allowed per client IP per minute.
AUTH_RATE_PER_MINUTE=10

# PostgreSQL connection. Set DATABASE_URL instead to use a full connection string.
DB_HOST=localhost
DB_PORT=5432
DB_USER=shop
DB_PASSWORD=change-me
DB_NAME=shop
DB_SSLMODE=disable

# Admin account created by `make seed`. The password must be at least 12 characters.
ADMIN_EMAIL=admin@shop.test
ADMIN_PASSWORD=change-me
